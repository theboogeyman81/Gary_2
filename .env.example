# Anthropic API key for Claude (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=your-key-here

# Redis connection (defaults are fine for local dev)
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Voice agent (LiveKit + Deepgram + Gemini + Cartesia) ---
# LiveKit Cloud — livekit.io → your project → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Deepgram STT — console.deepgram.com (free $200 credit)
DEEPGRAM_API_KEY=your-deepgram-api-key

# Google Gemini LLM — aistudio.google.com/apikey (free tier)
GOOGLE_API_KEY=your-google-api-key

# Cartesia TTS — cartesia.ai → Dashboard → API Keys (1M chars/mo free)
CARTESIA_API_KEY=your-cartesia-api-key

# --- Gesture pipeline ---
# Run `uv run python -m scripts.list_cameras` to identify which index is which
POV_CAMERA_SOURCE=mac:0
HAND_CAMERA_SOURCE=mac:1
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
CENTERED_REGION_FRACTION=0.4
STABILITY_FRAMES_ENTER=5
STABILITY_FRAMES_LEAVE=10
PINCH_HOLD_FRAMES=5
PINCH_THRESHOLD=0.04
GESTURE_COOLDOWN_MS=1500
